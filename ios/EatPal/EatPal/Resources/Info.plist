<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>EatPal</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchScreenBackground</string>
        <key>UIImageName</key>
        <string>LaunchIcon</string>
    </dict>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.eatpal.app</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>eatpal</string>
            </array>
        </dict>
    </array>
    <key>NSUserActivityTypes</key>
    <array>
        <string>com.eatpal.app.openMealPlan</string>
        <string>com.eatpal.app.openGroceryList</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>SUPABASE_URL</key>
    <string>$(SUPABASE_URL)</string>
    <key>SUPABASE_ANON_KEY</key>
    <string>$(SUPABASE_ANON_KEY)</string>
    <key>SENTRY_DSN</key>
    <string>$(SENTRY_DSN)</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <!-- The camera does more than barcodes: receipts (ScanReceiptSheet), fridge
         contents (FridgePhotoSheet), product identification (QuickAddGrocerySheet,
         PhotoImportGrocerySheet) and the AR shelf finder all use it. A purpose
         string has to describe what actually happens, and the recognition paths
         send the image off the device, which the user should be told before they
         say yes. (Distinct from ImageUploadService, which stores photos the user
         deliberately attaches to a food, recipe or child.) -->
    <key>NSCameraUsageDescription</key>
    <string>EatPal uses the camera to scan barcodes and receipts, and to recognize food from a photo of your fridge or a product. Photos used for recognition are sent to our service for processing.</string>
    <!-- Kept deliberately even though nothing currently triggers it. Photo
         selection goes through SwiftUI's PhotosPicker (PHPickerViewController),
         which runs out of process and needs no authorization. This is the guard
         for the day something reaches for PHPhotoLibrary directly, where a
         missing string is an immediate crash rather than a denied prompt. -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>EatPal needs photo library access to add profile pictures and food photos.</string>
    <!-- NSPhotoLibraryAddUsageDescription removed: nothing in the app writes to
         the photo library. There is no UIImageWriteToSavedPhotosAlbum and no
         PHPhotoLibrary.performChanges anywhere, so the string was telling users
         EatPal saves photos to their library when it does not. Re-add it in the
         same change that adds a save path, not before. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>EatPal uses the microphone so you can add grocery items by voice.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>EatPal uses speech recognition to turn what you say into grocery items. Recognition runs on-device when available.</string>
    <key>NSHealthShareUsageDescription</key>
    <string>EatPal reads your Health data so we can show how recorded meals fit into your day — only if you opt in.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>EatPal saves logged meals to Health as calories, protein, carbs, and fat so your nutrition picture stays in sync — only if you opt in.</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>
    <key>NSSupportsLiveActivities</key>
    <true/>
    <key>NSSupportsLiveActivitiesFrequentUpdates</key>
    <true/>
</dict>
</plist>
