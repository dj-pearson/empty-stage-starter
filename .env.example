# EatPal Environment Variables
# Copy this file to .env and fill in your values

# Required: Supabase Configuration
# Get these from your Supabase project dashboard or self-hosted instance
VITE_SUPABASE_URL=https://api.tryeatpal.com
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Edge Functions URL (if different from API URL)
VITE_FUNCTIONS_URL=https://functions.tryeatpal.com

# Optional: Error Monitoring with Sentry
# A Sentry DSN is a public client-side value (safe to ship in the bundle), so the
# EatPal project DSN is baked in as the default in src/lib/sentry.tsx. Leave this
# blank to use that default, or override it (e.g. for staging's own project).
VITE_SENTRY_DSN=https://5a588ac81d62a986ebd2f49a527b1e26@o4510398791352320.ingest.us.sentry.io/4511770287865856
VITE_SENTRY_ENABLED=false

# Optional: Sentry Vite Plugin (for production sourcemaps)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional: Email notifications
EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Optional: SEO & Analytics APIs
PAGESPEED_INSIGHTS_API_KEY=

# Optional: Stripe (for payments)
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional: Google Analytics
VITE_GA_MEASUREMENT_ID=

# Optional: Google Indexing API (service account JSON key - set on Edge Function env)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"...",...}
