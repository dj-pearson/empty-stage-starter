# Global headers for all pages
/*
  # Security headers
  # Clickjacking protection
  X-Frame-Options: DENY

  # MIME type sniffing protection
  X-Content-Type-Options: nosniff

  # XSS protection (disabled in favor of CSP per modern best practice)
  X-XSS-Protection: 0

  # Referrer policy (privacy)
  Referrer-Policy: strict-origin-when-cross-origin

  # Feature policy (privacy)
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=(self), usb=(), magnetometer=(), gyroscope=(), accelerometer=()

  # Cross-Origin policies
  # NOTE: Cross-Origin-Embedder-Policy is intentionally NOT set. COEP (even
  # 'credentialless') blocks cross-origin subresources/iframes that don't opt
  # in via CORP/COEP, which breaks the Stripe Elements iframe (js.stripe.com)
  # and third-party images the app renders. COOP + CORP below are safe and
  # deliver most of the isolation benefit without that breakage.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

  # HTTP Strict Transport Security
  # Kept in THIS single /* block on purpose. A second, separate `/*` block used
  # to define HSTS on its own; Cloudflare Pages does not reliably merge two
  # blocks that target the same path, so the duplicate `/*` caused every other
  # global security header (CSP, X-Frame-Options, Permissions-Policy, …) to be
  # dropped from the response. All global headers now live in one /* block.
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # DNS prefetch control
  X-DNS-Prefetch-Control: on

  # Content Security Policy (US-529: hardened — no 'unsafe-inline'/'unsafe-eval' in script-src)
  # script-src is now strict 'self' + explicit third-party origins:
  #   - The former inline GA loader was externalized to /ga-loader.js (served from 'self').
  #   - Vite's inline modulepreload-polyfill is disabled (build.modulePreload.polyfill=false),
  #     so the built index.html carries zero inline <script>. The ld+json block is data, not
  #     executable, and is exempt from script-src.
  #   - 'unsafe-eval' dropped: Three.js/@react-three compile shaders on the GPU via WebGL, not
  #     JS eval(); no app or vendor code needs eval/new Function.
  #   - cdn.jsdelivr.net removed (unused — only appeared in a test fixture string).
  # style-src keeps 'unsafe-inline' (React/Tailwind inline styles + the <noscript> block);
  #   AC scope is script-src only, and inline styles cannot exfiltrate the session token.
  # img-src DELIBERATELY stays permissive (https:): the app renders arbitrary-host images it
  #   does not control — imported recipe/product images (openfoodfacts et al.), CMS blog featured
  #   images, and user/OAuth avatars (avatar.vercel.sh, lh3.googleusercontent.com, …). A fixed
  #   allowlist would break these on production. The exfil risk a tight img-src would mitigate
  #   (an injected <img src=evil?data=…>) already requires script execution, which the hardened
  #   script-src now blocks — so the marginal benefit is low and the breakage risk is high.
  # Self-hosted Supabase: api.tryeatpal.com, functions.tryeatpal.com
  # Cloudflare Web Analytics is auto-injected by Pages into every response: it loads
  #   static.cloudflareinsights.com/beacon.min.js and beacons to cloudflareinsights.com/cdn-cgi/rum.
  #   Both must be allowed or the console logs a CSP violation on every page load.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://js.stripe.com https://static.cloudflareinsights.com https://*.tryeatpal.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https: blob:; connect-src 'self' https://www.google-analytics.com https://www.googletagmanager.com https://api.tryeatpal.com https://functions.tryeatpal.com wss://api.tryeatpal.com https://api.stripe.com https://*.sentry.io https://cloudflareinsights.com; frame-src 'self' https://js.stripe.com https://hooks.stripe.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests; block-all-mixed-content;

  # Report CSP violations (for monitoring)
  # Content-Security-Policy-Report-Only: default-src 'self'; report-uri /api/csp-report;
  
  # Performance and caching
  Cache-Control: public, max-age=0, must-revalidate

  # CORS headers removed - not needed for same-origin SPA
  # Supabase handles CORS for its API endpoints
  # If you need CORS for specific routes, add them below with specific origins

# Static assets - long-term caching
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts - long-term caching
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images - long-term caching for optimized assets
/assets/images/*
  Cache-Control: public, max-age=31536000, immutable
  
/*.webp
  Cache-Control: public, max-age=31536000, immutable
  
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
  
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
  
/*.png
  Cache-Control: public, max-age=31536000, immutable
  
/*.svg
  Cache-Control: public, max-age=31536000, immutable
  
/*.gif
  Cache-Control: public, max-age=31536000, immutable

# JavaScript and CSS - versioned assets
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript; charset=utf-8
  
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: text/css; charset=utf-8

# API routes - no caching
/api/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Sitemap files - moderate caching
/sitemap*.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

# Robots.txt - moderate caching
/robots.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

# LLM information files - moderate caching
/llms.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: noindex

/llms-full.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: noindex

# RSS and Atom feeds
/rss.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/rss+xml; charset=utf-8

/feed.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/atom+xml; charset=utf-8

# Manifest files
/manifest.json
  Cache-Control: public, max-age=3600
  Content-Type: application/json; charset=utf-8
  
/.well-known/*
  Cache-Control: public, max-age=3600

# Apple Universal Links. Apple's CDN requires application/json and will not follow a
# redirect, so this path has to answer directly with the right type. The file itself is
# generated at build time by scripts/generate-aasa.mjs and only exists when
# APPLE_TEAM_ID is set. Note there is no `charset` here on purpose: the extensionless
# filename plus a bare application/json is the shape Apple documents.
/.well-known/apple-app-site-association
  Cache-Control: public, max-age=3600
  Content-Type: application/json

# Favicon files - UPDATED: force cache refresh for new favicon
/favicon.ico
  Cache-Control: public, max-age=86400, must-revalidate
  
/favicon*.png
  Cache-Control: public, max-age=86400, must-revalidate
  
/apple-touch-icon*.png
  Cache-Control: public, max-age=86400, must-revalidate

/android-chrome*.png
  Cache-Control: public, max-age=86400, must-revalidate

# Service worker
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# HTML files - short caching for SPA
/*.html
  Cache-Control: public, max-age=300
  Content-Type: text/html; charset=utf-8

# Security headers for admin routes
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache, no-store, must-revalidate

# SEO optimization headers
/blog/*
  Cache-Control: public, max-age=3600
  
# Preload critical resources
/
  Link: </Logo-Green.webp>; rel=preload; as=image; type=image/webp

