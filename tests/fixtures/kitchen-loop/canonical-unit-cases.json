{
  "$comment": "US-660: shared cases for toCanonical. Asserted by BOTH src/lib/kitchenLoopFixtures.test.ts and the Swift mirror (US-682). This is the write boundary for inventory_movements.delta, so a drift here is a wrong pantry on one platform.",
  "$format": {
    "name": "human label for the case, shown on failure",
    "quantity": "numeric amount to convert",
    "unit": "unit as written by a parent, a recipe or a receipt",
    "item": "the foods-row facts: canonical_unit, unit_conversions, density_g_per_ml. Any may be absent.",
    "expected": "either { value, unit } with value compared inside `tolerance`, or { unknown: true, reasonMatches: <substring> }",
    "tolerance": "absolute slack on value; defaults to 0.01 when absent",
    "$note": "Swift mirror: decode and assert toCanonical(quantity, unit, item). An `unknown` case must return the unknown variant, and its reason must CONTAIN reasonMatches — do not compare reasons exactly, the wording is allowed to differ in punctuation."
  },
  "cases": [
    { "name": "grams to grams is identity", "quantity": 250, "unit": "g", "item": { "canonical_unit": "g" }, "expected": { "value": 250, "unit": "g" } },
    { "name": "kilograms to grams", "quantity": 1, "unit": "kg", "item": { "canonical_unit": "g" }, "expected": { "value": 1000, "unit": "g" } },
    { "name": "pounds to grams", "quantity": 1, "unit": "lb", "item": { "canonical_unit": "g" }, "expected": { "value": 453.592, "unit": "g" }, "tolerance": 0.01 },
    { "name": "ounces to grams", "quantity": 16, "unit": "oz", "item": { "canonical_unit": "g" }, "expected": { "value": 453.592, "unit": "g" }, "tolerance": 0.5 },
    { "name": "a pound and sixteen ounces agree", "quantity": 2, "unit": "lb", "item": { "canonical_unit": "g" }, "expected": { "value": 907.184, "unit": "g" }, "tolerance": 0.02 },
    { "name": "millilitres to millilitres is identity", "quantity": 500, "unit": "ml", "item": { "canonical_unit": "ml" }, "expected": { "value": 500, "unit": "ml" } },
    { "name": "litres to millilitres", "quantity": 2, "unit": "l", "item": { "canonical_unit": "ml" }, "expected": { "value": 2000, "unit": "ml" } },
    { "name": "US gallon to millilitres", "quantity": 1, "unit": "gal", "item": { "canonical_unit": "ml" }, "expected": { "value": 3785.41, "unit": "ml" }, "tolerance": 0.01 },
    { "name": "two gallons, the moveCheckedToPantry case", "quantity": 2, "unit": "gal", "item": { "canonical_unit": "ml" }, "expected": { "value": 7570.82, "unit": "ml" }, "tolerance": 0.02 },
    { "name": "256 fluid ounces is the same as two gallons", "quantity": 256, "unit": "fl oz", "item": { "canonical_unit": "ml" }, "expected": { "value": 7570.82, "unit": "ml" }, "tolerance": 0.5 },
    { "name": "quart to millilitres", "quantity": 1, "unit": "qt", "item": { "canonical_unit": "ml" }, "expected": { "value": 946.353, "unit": "ml" }, "tolerance": 0.01 },
    { "name": "cup to millilitres", "quantity": 1, "unit": "cup", "item": { "canonical_unit": "ml" }, "expected": { "value": 236.588, "unit": "ml" }, "tolerance": 0.01 },
    { "name": "tablespoon to millilitres", "quantity": 1, "unit": "tbsp", "item": { "canonical_unit": "ml" }, "expected": { "value": 14.7868, "unit": "ml" }, "tolerance": 0.001 },
    { "name": "teaspoon to millilitres", "quantity": 1, "unit": "tsp", "item": { "canonical_unit": "ml" }, "expected": { "value": 4.92892, "unit": "ml" }, "tolerance": 0.001 },
    { "name": "half gallon, the token the mobile picker offers", "quantity": 1, "unit": "½ gal", "item": { "canonical_unit": "ml" }, "expected": { "value": 1892.71, "unit": "ml" }, "tolerance": 0.01 },
    { "name": "pieces are counts", "quantity": 3, "unit": "piece", "item": { "canonical_unit": "count" }, "expected": { "value": 3, "unit": "count" } },
    { "name": "a dozen is twelve", "quantity": 2, "unit": "dozen", "item": { "canonical_unit": "count" }, "expected": { "value": 24, "unit": "count" } },
    { "name": "each is a count", "quantity": 5, "unit": "each", "item": { "canonical_unit": "count" }, "expected": { "value": 5, "unit": "count" } },
    { "name": "a can is an amount only for this item", "quantity": 2, "unit": "can", "item": { "canonical_unit": "g", "unit_conversions": { "can": 400 } }, "expected": { "value": 800, "unit": "g" } },
    { "name": "a bunch is an amount only for this item", "quantity": 3, "unit": "bunch", "item": { "canonical_unit": "g", "unit_conversions": { "bunch": 60 } }, "expected": { "value": 180, "unit": "g" } },
    { "name": "the item conversion beats the generic table", "quantity": 2, "unit": "cup", "item": { "canonical_unit": "g", "unit_conversions": { "cup": 120 } }, "expected": { "value": 240, "unit": "g" } },
    { "name": "conversion keys match through the same token rules as units", "quantity": 2, "unit": "fl oz", "item": { "canonical_unit": "g", "unit_conversions": { "Fl Oz": 30 } }, "expected": { "value": 60, "unit": "g" } },
    { "name": "millilitres to grams with a density", "quantity": 100, "unit": "ml", "item": { "canonical_unit": "g", "density_g_per_ml": 1.42 }, "expected": { "value": 142, "unit": "g" } },
    { "name": "grams to millilitres with the same density", "quantity": 142, "unit": "g", "item": { "canonical_unit": "ml", "density_g_per_ml": 1.42 }, "expected": { "value": 100, "unit": "ml" }, "tolerance": 0.001 },
    { "name": "a debit is a negative movement, not an error", "quantity": -250, "unit": "g", "item": { "canonical_unit": "g" }, "expected": { "value": -250, "unit": "g" } },
    { "name": "an undeclared item classifies from the unit itself", "quantity": 1, "unit": "lb", "item": {}, "expected": { "value": 453.592, "unit": "g" }, "tolerance": 0.01 },
    { "name": "an undeclared item classifies volume too", "quantity": 1, "unit": "cup", "item": {}, "expected": { "value": 236.588, "unit": "ml" }, "tolerance": 0.01 },
    { "name": "millilitres to grams refuses without a density", "quantity": 100, "unit": "ml", "item": { "canonical_unit": "g" }, "expected": { "unknown": true, "reasonMatches": "without a density" } },
    { "name": "a package unit with no per-item conversion is unknown", "quantity": 1, "unit": "jar", "item": { "canonical_unit": "g" }, "expected": { "unknown": true, "reasonMatches": "package unit" } },
    { "name": "an unrecognised unit is unknown", "quantity": 1, "unit": "sploots", "item": { "canonical_unit": "g" }, "expected": { "unknown": true, "reasonMatches": "unrecognised unit" } },
    { "name": "a density does not bridge count and mass", "quantity": 3, "unit": "piece", "item": { "canonical_unit": "g", "density_g_per_ml": 1 }, "expected": { "unknown": true, "reasonMatches": "per-item conversion" } },
    { "name": "a conversion with no canonical unit to express it in is unknown", "quantity": 1, "unit": "can", "item": { "unit_conversions": { "can": 400 } }, "expected": { "unknown": true, "reasonMatches": "no canonical_unit" } },
    { "name": "a zero density is refused rather than divided by", "quantity": 100, "unit": "ml", "item": { "canonical_unit": "g", "density_g_per_ml": 0 }, "expected": { "unknown": true, "reasonMatches": "without a density" } }
  ]
}
